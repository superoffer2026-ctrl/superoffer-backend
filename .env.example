PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:4200
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
DATABASE_URL=postgresql://superoffer:password@localhost:5432/superoffer?schema=public

ADMIN_APPROVAL_KEY=replace-with-a-separate-admin-approval-key

# Student login OTP (sent over WhatsApp)
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# WhatsApp sender: leave WHATSAPP_ACCESS_TOKEN/WHATSAPP_PHONE_NUMBER_ID unset to use
# the mock sender (logs the OTP instead of sending it) during local development.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_OTP_TEMPLATE_NAME=otp_login
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
