PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:4200
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
DATABASE_URL=postgresql://superoffer:password@localhost:5432/superoffer?schema=public

ADMIN_APPROVAL_KEY=replace-with-a-separate-admin-approval-key

# Encrypts PAN and other credit/identity fields at rest (src/common/field-crypto.ts).
# 32 bytes as hex (64 hex characters) or base64.
FIELD_ENCRYPTION_KEY=replace-with-a-32-byte-key-as-hex-or-base64

# Student OTP (sent over WhatsApp): proves the number at registration and on password reset
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# WhatsApp sender. Gallabox is the production provider and is chosen whenever its
# three credentials are set; the Meta variables below are the fallback. With
# neither configured the mock sender logs the OTP instead of sending it, which is
# what local development uses.
GALLABOX_API_KEY=
GALLABOX_API_SECRET=
GALLABOX_CHANNEL_ID=
GALLABOX_OTP_TEMPLATE_NAME=otp_login
# Named placeholder in the approved template body that receives the code.
GALLABOX_OTP_BODY_VARIABLE=otp
GALLABOX_BASE_URL=https://server.gallabox.com

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_OTP_TEMPLATE_NAME=otp_login
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US

# CIBIL credit checks, through SurePass. Backend only — there is deliberately no
# NEXT_PUBLIC_ twin, because a browser must never hold this token.
SUREPASS_TOKEN=
# Sandbox for now. Production is the same contract on https://kyc-api.surepass.io
SUREPASS_BASE_URL=https://sandbox.surepass.app
