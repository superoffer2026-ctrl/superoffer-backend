# -----------------------------------------------------------------------
# TEMPLATE ONLY — placeholders, no real secrets. This file IS committed.
#
# Setup:  cp .env.example .env   then edit .env with your real values.
# .env itself is gitignored and must never be committed.
# -----------------------------------------------------------------------

# Port the API listens on.
PORT=3000

# "development" or "production".
# In development you get request logs and full error stack traces.
NODE_ENV=development

# MongoDB Atlas connection string.
# Where to find it: Atlas dashboard -> your cluster -> "Connect" -> "Drivers".
#
# Format:
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
#
# Two things beginners commonly get wrong:
#   1. Put your database name (e.g. superoffer) before the "?" — otherwise
#      MongoDB silently uses a database called "test".
#   2. If your password contains @ : / or ?, it must be URL-encoded.
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING
