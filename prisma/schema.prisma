generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  UNIVERSITY_OFFICER
  LOAN_OFFICER
  CONSULTANT
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OrganizationType {
  UNIVERSITY
  BANK
  CONSULTANCY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StudyLevel {
  UG
  PG
  PHD
}

model User {
  id                  String          @id @default(uuid())
  /// Institutions and admins sign in with email+password. Students never have one:
  /// they are identified by `phone`, the WhatsApp number that receives their OTP,
  /// and the student signup form neither asks for nor stores an address.
  email               String?         @unique
  /// Required in practice for students (enforced in AuthService, since the column
  /// is shared with institutions where it is an optional contact detail).
  phone               String?         @unique
  passwordHash        String?
  fullName            String?
  role                Role            @default(STUDENT)
  status              UserStatus      @default(ACTIVE)
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  /// Stamped whenever the account password is changed; the settings screens show it.
  passwordChangedAt   DateTime?
  organizationId      String?
  organization        Organization?   @relation(fields: [organizationId], references: [id])
  studentProfile      StudentProfile?
  authSessions        AuthSession[]
  offers              Offer[]
  shortlistedBy       Shortlist[]
  loginEvents         LoginEvent[]
  creditConsents      CreditConsent[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@map("users")
}

/// One row per registering institution (university, bank, or consultancy).
/// Institution officers can't search/invite until verificationStatus = APPROVED.
model Organization {
  id                 String                        @id @default(uuid())
  name               String
  organizationType   OrganizationType
  registrationNumber String?
  licenseReference   String?
  website            String?
  country            String?
  city               String?
  verificationStatus ApprovalStatus                @default(PENDING)
  submittedAt        DateTime                      @default(now())
  reviewedAt         DateTime?
  rejectionReason    String?
  reviewNote         String?
  /// Editable profile copy shown in the workspace's Org Profile tab.
  description        String?
  /// Opaque media references, not paths and not URLs.
  ///
  /// The value is a storage key the media layer resolves — `local/...` today,
  /// an S3 object key tomorrow. Nothing outside that layer parses it, so moving
  /// to cloud storage changes one class rather than every row and every screen.
  logoRef            String?
  coverRef           String?
  /// The plan of last resort: what an organisation gets before anyone has sold
  /// them anything. The active paid `Subscription` overrides it, and is the only
  /// thing that can — an organisation cannot promote itself.
  plan               String                        @default("Professional")
  /// Usage before any subscription existed. Live counting happens per period on
  /// `Subscription.profilesViewed`, so a new period starts at zero by construction.
  profilesViewed     Int                           @default(0)
  /// Set by an admin to cut off an organisation that has not paid. Deliberately
  /// manual: an overdue invoice shows as a warning, and a human decides whether
  /// it is worth switching a customer off.
  suspendedAt        DateTime?
  suspensionReason   String?
  subscriptions      Subscription[]
  profileViews       ProfileView[]
  /// Bank-only: which students an officer may evaluate (docs/09-Business-Rules.md).
  bankEvaluationMode String?
  bureauCredential   OrganizationBureauCredential?
  /// Matching thresholds the discovery score is computed from.
  criteria           Json                          @default("{}")
  /// Per-officer-organization notification frequencies.
  notificationPrefs  Json                          @default("[]")
  /// Reusable offer term sets the composer loads from.
  offerTemplates     Json                          @default("[]")
  users              User[]
  offers             Offer[]
  products           OrganizationProduct[]
  shortlist          Shortlist[]
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@map("organizations")
}

/// Backs refresh-token revocation (GET/DELETE /auth/sessions) and
/// "invalidate other sessions" on password reset.
model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  deviceInfo       String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@map("auth_sessions")
}

/// Student OTPs, delivered over WhatsApp. `purpose` is REGISTER (confirming a
/// number at signup, which signs the student in) or PASSWORD_RESET (which only
/// unlocks the set-a-new-password step). Kept as a string rather than an enum so
/// further purposes cost no migration.
model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  purpose    String    @default("LOGIN")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("otp_codes")
}

/// Append-only trail of Super Admin actions (approvals/rejections), surfaced
/// on the admin panel's "Audit log" tab.
/// One immutable version of the admin-authored student form. A draft is edited
/// freely; publishing freezes it and makes it the version students see.
/// A rule that asked to wait. One row per rule per trigger, so a delayed
/// message cannot be queued twice however often the event is re-emitted.
model ScheduledAutomation {
  id          String         @id @default(uuid())
  ruleId      String
  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  offerId     String
  offer       Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  /// What the rule reacted to, carried through so the eventual write stays idempotent.
  triggerRef  String
  /// The side whose action started the wait; still not badged when it lands.
  actor       String
  /// Placeholders captured at trigger time, e.g. an uploaded document's name.
  extra       Json?
  /// Which action of the rule is waiting.
  ///
  /// A rule can now hold several scheduled action sets at different times — a
  /// nudge after a day and a last call after a week — so a queued row has to
  /// say which of them it is, or the worker would run the whole rule again.
  actionIndex Int            @default(0)
  dueAt       DateTime
  /// PENDING, SENT, SKIPPED or FAILED. A skip is an outcome, not a loss.
  status      String         @default("PENDING")
  /// Why it did not send, in the words the panel shows.
  skipReason  String?
  attempts    Int            @default(0)
  /// Held by whichever worker claimed the row, so two instances cannot both send.
  claimedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([ruleId, offerId, triggerRef, actionIndex])
  @@index([status, dueAt])
  @@map("scheduled_automations")
}

/// A named list of choices that fields point at.
///
/// These began as compile-time constants, which meant three consumers read the
/// same list from source: DTO validation, the /reference endpoints the
/// hand-drawn dropdowns use, and the published form schema. Moving them here
/// gives all three one editable definition — otherwise an option added in the
/// admin renders in the dropdown and is then rejected on save.
model OptionSet {
  id          String   @id @default(uuid())
  /// Stable identifier a field refers to, e.g. "studyCountries".
  key         String   @unique
  /// What an admin sees, e.g. "Study destinations".
  label       String
  description String?
  /// The choices, in the order they are offered.
  values      String[] @default([])
  /// Seeded from the master sheet. An admin may edit these but not delete the
  /// set, because a field somewhere points at it.
  system      Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("option_sets")
}

model FormSchema {
  id          String    @id @default(uuid())
  /// Which form this is: STUDENT_PROFILE, ORG_OFFER, ORG_PRODUCT, ORG_PRODUCT_INVITE.
  /// A form and a variant together identify one editable document.
  formKey     String    @default("STUDENT_PROFILE")
  /// Monotonic per form and variant, so history reads in order.
  version     Int
  /// DRAFT, PUBLISHED or ARCHIVED. Only one PUBLISHED per form and variant.
  status      String    @default("DRAFT")
  /// For the student profile, an audience such as UG or PG. For an organisation
  /// form, the organisation type it belongs to: UNIVERSITY, BANK, CONSULTANCY.
  variant     String    @default("DEFAULT")
  label       String
  /// The whole FormSchemaDef, stored as one document.
  definition  Json
  /// What the publish check reported at the time it went live.
  publishNote String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([formKey, variant, version])
  @@index([formKey, variant, status])
  @@map("form_schemas")
}

/// An admin-authored rule: when this happens, post this into the offer thread.
model AutomationRule {
  id           String                @id @default(uuid())
  /// The domain event that fires it, e.g. "offer.accepted".
  event        String
  label        String
  /// Who the message is addressed to: student, organization, or both.
  audience     String                @default("both")
  /// "system" for a neutral notice, "organization" for a labelled auto-reply.
  attribution  String                @default("system")
  /// Message body, with {{placeholders}} filled from the offer and its parties.
  ///
  /// Kept for the rules written before a rule could do more than one thing, and
  /// as the source the backfill reads. `actions` is what the dispatcher runs.
  body         String
  /// What the rule does when it fires, in order.
  ///
  /// A rule used to be able to say exactly one thing, to one audience, in one
  /// place, because the message was welded to the row as body/audience/
  /// attribution. An action list is the seam that lets one trigger notify a
  /// student on WhatsApp and the officer in the native chat, and lets new kinds
  /// of action arrive without another migration.
  actions      Json                  @default("[]")
  /// Optional narrowing, e.g. { "organizationType": "BANK" }.
  condition    Json?
  /// Whether it badges the recipient. The actor is never badged for their own action.
  markUnread   Boolean               @default(true)
  /// Minutes to wait after the event. 0 posts immediately, in the same request.
  delayMinutes Int                   @default(0)
  /// Re-read when a delayed rule comes due: the reason to still send it. A
  /// nudge written three days ago must not go out if the student has replied.
  guard        Json?
  scheduled    ScheduledAutomation[]
  deliveries   AutomationDelivery[]
  enabled      Boolean               @default(true)
  order        Int                   @default(1)
  /// Seeded rules, which an admin may edit or disable but not delete.
  system       Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([event, enabled])
  @@map("automation_rules")
}

/// A student who accepted an offer, and what our team found when they checked.
///
/// The row exists so an admission can be followed up and, once confirmed, the
/// student's personal data removed — a student already at a university should
/// not keep being recommended to universities and lenders.
///
/// Keyed on the offer rather than the student: a student may hold several
/// offers, and it is one specific acceptance being verified.
model AdmissionFollowUp {
  id          String    @id @default(uuid())
  offerId     String    @unique
  offer       Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  /// PENDING while nobody has checked, then CONFIRMED or NOT_ADMITTED.
  status      String    @default("PENDING")
  /// What the team was told when they checked with the university.
  note        String?
  checkedBy   String?
  confirmedAt DateTime?
  /// Set once the student's personal data has been redacted. Irreversible.
  purgedAt    DateTime?
  purgedBy    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@map("admission_follow_ups")
}

model AuditLog {
  id               String   @id @default(uuid())
  action           String
  organizationName String?
  entityId         String?
  actorUserId      String?
  reason           String?
  occurredAt       DateTime @default(now())

  @@map("audit_log")
}

/// One row per student, holding both profile surfaces.
///
/// `personal`/`studyPreferences`/`entranceExams`/`workExperience`/`projects` back the
/// nine-step wizard under /student/*, one column per wizard section, so each
/// PUT /students/me/<section> writes exactly one column.
///
/// `basic`/`studyLevel`/`selectedTests`/`testDetails`/`achievements`/`links` back the
/// older ten-step flow at /student/onboarding. `academic` and `financial` are shared
/// by both. See docs/10-Open-Decisions.md #2 — the two surfaces are meant to converge.
model StudentProfile {
  id               String      @id @default(uuid())
  userId           String      @unique
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  personal         Json        @default("{}")
  studyPreferences Json        @default("{}")
  academic         Json        @default("{}")
  entranceExams    Json        @default("{}")
  workExperience   Json        @default("{}")
  financial        Json        @default("{}")
  /// The parent or guardian who stands as co-applicant on an education loan.
  /// Their PAN is stored encrypted; everything that leaves the server masks it.
  coApplicant      Json        @default("{}")
  projects         Json        @default("{}")
  basic            Json        @default("{}")
  studyLevel       StudyLevel?
  preferences      Json        @default("{}")
  selectedTests    String[]    @default([])
  testDetails      Json        @default("{}")
  achievements     Json        @default("{}")
  links            Json        @default("{}")
  status           String      @default("DRAFT")
  /// Notification and privacy toggles from the student's Settings screen.
  settings         Json        @default("{}")
  /// The student's own visibility switch; discovery honours it alongside `status`.
  discoverable     Boolean     @default(true)
  /// Where this student is in their life with us: STUDENT or ALUMNI.
  ///
  /// An alumnus has been admitted somewhere and our team has verified it, so
  /// they stop being offered to universities and lenders — they already have
  /// what those offers were for. Kept apart from `discoverable`, which is the
  /// student's own choice about being seen; this one is ours, and a student
  /// should not be able to opt back into being recommended after admission.
  segment          String      @default("STUDENT")
  alumniSince      DateTime?
  /// The offer whose admission made them an alumnus.
  alumniOfferId    String?
  /// Whether this student still needs a seat, and whether they still need funding.
  ///
  /// Two markets, filled independently: accepting a place says nothing about
  /// whether the fees are covered, and arranging a loan says nothing about
  /// where they are going. One flag for both would hide a funded student from
  /// every university, or keep selling a placed student to banks that pay per
  /// candidate — so each side is closed by its own acceptance and reopened by
  /// its own withdrawal.
  ///
  /// OPEN or PLACED. Set from the student's own decision, so the market closes
  /// the moment they commit rather than whenever an admin gets round to it;
  /// `segment` remains the slower, verified judgement on top.
  admissionStatus  String      @default("OPEN")
  financeStatus    String      @default("OPEN")
  submittedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([segment])
  @@index([admissionStatus])
  @@index([financeStatus])
  @@map("student_profiles")
}

/// One billing period an organisation has been sold, and whether they paid for it.
///
/// Money changes hands offline — a transfer, a cheque, an invoice settled by the
/// finance team — so nothing here charges anybody. It records what was agreed and
/// what has been received, so the organisation can see their own bills and our
/// team can see who still owes.
model Subscription {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Basic, Professional or Enterprise. The active paid row decides the quota.
  plan           String
  periodStart    DateTime
  periodEnd      DateTime
  /// Stored in the smallest unit — paise for INR — so no total is ever a float.
  amountMinor    Int
  currency       String        @default("INR")
  /// DRAFT, ISSUED, PAID, OVERDUE or CANCELLED.
  status         String        @default("ISSUED")
  /// Human-readable, e.g. SO-2026-0007. What a customer quotes when they call.
  invoiceNumber  String        @unique
  /// How the offline payment arrived: a NEFT reference, a cheque number.
  paymentRef     String?
  paidAt         DateTime?
  /// Who on our side confirmed the money landed.
  recordedBy     String?
  note           String?
  /// Views used inside this period. A new period is a new row, so it starts at zero.
  profilesViewed Int           @default(0)
  views          ProfileView[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, periodStart])
  @@index([status])
  @@map("subscriptions")
}

/// One student, opened by one organisation, once per billing period.
///
/// The row exists so a second look at the same student does not cost a second
/// view: an organisation pays to reach a person, not to re-open a page.
model ProfileView {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentUserId  String
  /// Null only for a view taken while nothing was sold.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  viewedAt       DateTime      @default(now())

  @@unique([organizationId, studentUserId, subscriptionId])
  @@index([organizationId, viewedAt])
  @@map("profile_views")
}

/// A course or loan product an organization recruits/lends against. Replaces the
/// catalog the workspace used to keep in localStorage.
model OrganizationProduct {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// "Academic Product" or "Financial Product" — drives which offer-condition presets apply.
  category       String?
  url            String?
  /// Category-specific detail (rate bands, and anything an admin adds) still kept
  /// flexible. The academic fields below were promoted out of here: a student
  /// comparing three universities needs tuition and duration to mean the same
  /// thing in each offer, which a free-form blob cannot promise.
  terms          Json            @default("{}")
  /// The academic shape of a programme. Nullable throughout: this table is shared
  /// with lenders, whose products have none of these.
  degreeLevel    String?
  fieldOfStudy   String?
  durationMonths Int?
  studyMode      String?
  campusLocation String?
  intakes        String[]        @default([])
  /// Smallest currency unit, so no fee is ever held as a float.
  tuitionFeeMinor Int?
  currency       String?
  scholarshipInfo String?
  imageRef       String?
  /// The offers this product is willing to make. One is the default.
  templates      OfferTemplate[]
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@map("organization_products")
}

/// An offer a product is prepared to make, written once and sent many times.
///
/// Terms belong here rather than being typed per invitation: an officer choosing
/// a product is choosing terms the organisation already agreed to, which is what
/// makes a one-click invitation safe to offer at all.
model OfferTemplate {
  id                 String              @id @default(uuid())
  productId          String
  product            OrganizationProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Denormalised so a template can be found without joining through the product.
  organizationId     String
  name               String
  description        String?
  /// The offer's figures, in the vocabulary the comparison and valuation read.
  terms              Json                @default("{}")
  /// What the student sees first, e.g. "40% tuition".
  value              String?
  valueLabel         String?
  conditions         String?
  nextSteps          String[]            @default([])
  /// Days the student has to respond. Absent falls back to the platform default.
  responseWindowDays Int?
  /// The one a single-click invitation uses. Exactly one per product.
  isDefault          Boolean             @default(false)
  archivedAt         DateTime?
  /// How many invitations have gone out on it, so a dead template is visible.
  usedCount          Int                 @default(0)
  offers             Offer[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([organizationId])
  @@index([productId, isDefault])
  @@map("offer_templates")
}

/// An organization's saved students. Was a localStorage set of names.
model Shortlist {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentUserId  String
  student        User         @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  /// How the officer triaged this candidate: SHORTLISTED or REJECTED.
  status         String       @default("SHORTLISTED")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, studentUserId])
  @@index([organizationId])
  @@map("shortlists")
}

/// Every authentication attempt, for the admin panel's Auth logs.
model LoginEvent {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  role       String?
  outcome    String
  ip         String?
  userAgent  String?
  occurredAt DateTime @default(now())

  @@index([occurredAt])
  @@map("login_events")
}

/// What the student sees the offer as. An organization's type decides the default
/// (UNIVERSITY -> UNIVERSITY, BANK -> BANK) but a university can also send a
/// SCHOLARSHIP, so it is stored per offer rather than derived on read.
enum OfferCategory {
  UNIVERSITY
  BANK
  SCHOLARSHIP
  CONSULTANCY
}

/// The organization's view of the lifecycle. Terminal states (ACCEPTED, REJECTED,
/// WITHDRAWN, EXPIRED) are final — see docs/06-Offers-Module.md.
enum OfferStatus {
  SENT
  VIEWED
  NEGOTIATING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

/// The student's view of the same offer. Kept separate from OfferStatus because the
/// two vocabularies differ: an offer the organization sees as SENT is PENDING here.
enum StudentDecision {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
}

/// One invitation from an organization to a student.
model Offer {
  id                   String                @id @default(uuid())
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentUserId        String
  student              User                  @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  category             OfferCategory
  /// The template this went out on, when it came from one. Null for a hand-written
  /// offer, so "which template converts" stays an answerable question.
  templateId           String?
  template             OfferTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// The university and programme as they stood the day this offer was sent.
  ///
  /// Frozen deliberately. An offer is a promise made on a date, and pointing at
  /// the live programme would let next year's tuition rewrite what a student was
  /// already promised — silently, and after they had decided on it.
  programSnapshot      Json                  @default("{}")
  program              String
  headline             String
  /// The template's own description, carried onto the offer it was sent from —
  /// distinct from `conditions`, which is the terms a student must meet.
  description          String?
  status               OfferStatus           @default(SENT)
  studentDecision      StudentDecision       @default(PENDING)
  /// Category-specific figures rendered by the comparison table: tuitionFee and
  /// scholarshipPct for universities, loanAmount and interestRate for banks, and so on.
  terms                Json                  @default("{}")
  conditions           String?
  nextSteps            String[]              @default([])
  contactName          String?
  contactRole          String?
  location             String?
  intake               String?
  valueLabel           String?
  value                String?
  /// Student-side flags; they belong to the one student the offer was sent to.
  viewedAt             DateTime?
  /// When each side last opened this thread. Anything sent after their stamp is
  /// unread for them; the two are tracked separately so one side reading does
  /// not clear the other's badge.
  studentReadAt        DateTime?
  organizationReadAt   DateTime?
  savedByStudent       Boolean               @default(false)
  favourite            Boolean               @default(false)
  compared             Boolean               @default(false)
  respondedAt          DateTime?
  /// 14 days from creation unless the sender overrides it.
  expiresAt            DateTime
  withdrawnAt          DateTime?
  messages             OfferMessage[]
  scheduledAutomations ScheduledAutomation[]
  admissionFollowUp    AdmissionFollowUp?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([studentUserId, status])
  @@index([organizationId, status])
  @@map("offers")
}

model OfferMessage {
  id          String   @id @default(uuid())
  offerId     String
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  /// "institution", "student", or "system" for an automated notice.
  sender      String
  /// True when automation wrote this rather than a person, so the UI can say so
  /// instead of implying an officer typed it.
  automatic   Boolean  @default(false)
  /// Which rule produced it, and what it was reacting to. Together with offerId
  /// these make automation idempotent — a retried request cannot post twice.
  ruleId      String?
  triggerRef  String?
  /// Who an automated message is for: "student", "organization", or "both".
  /// A notice meant for the officer is not shown to the student who caused it.
  audience    String?
  authorName  String
  body        String
  /// One optional attachment. Stored the way student documents are: the bytes on
  /// disk under a random name, the original name kept for display.
  fileName    String?
  storagePath String?
  mimeType    String?
  fileSize    Int?
  sentAt      DateTime @default(now())

  @@unique([offerId, ruleId, triggerRef])
  @@index([offerId])
  @@map("offer_messages")
}

model StudentDocument {
  id           String   @id @default(uuid())
  userId       String
  documentType String
  fileName     String
  mimeType     String
  size         Int
  storagePath  String
  uploadedAt   DateTime @default(now())

  @@index([userId])
  @@map("student_documents")
}

/// Permission to look up someone's credit information: who granted it, to whom,
/// for what, and until when.
///
/// This is the artefact a lender's compliance team asks for, so it is a record
/// in its own right rather than a flag on a profile — it outlives the check it
/// authorised, and a revoked consent must still show that it once existed.
model CreditConsent {
  id             String        @id @default(uuid())
  /// The student whose co-applicant is the subject. The subject is not a user of
  /// the platform, so consent hangs off the student who entered their details.
  studentUserId  String
  student        User          @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  /// The organisation allowed to look, or null when the subject is retrieving
  /// their own report — which is their right, and needs no lender.
  organizationId String?
  /// SELF_PULL or LENDER_PULL.
  kind           String
  /// Plain-English purpose, shown to the person granting it and kept verbatim.
  purpose        String
  /// What they were shown when they agreed, so the wording can change later
  /// without rewriting what anyone actually consented to.
  statement      String
  grantedAt      DateTime      @default(now())
  /// Consent is never open-ended; a lender re-asks rather than assuming.
  expiresAt      DateTime
  revokedAt      DateTime?
  /// Captured for the audit trail a bureau contract requires.
  grantedIp      String?
  checks         CreditCheck[]

  @@index([studentUserId])
  @@index([organizationId, expiresAt])
  @@map("credit_consents")
}

/// The outcome of one credit look-up.
///
/// Deliberately holds a band and a provider reference rather than the report:
/// the less credit information stored here, the smaller the obligation, and a
/// lender re-pulls the full file under its own membership when it underwrites.
model CreditCheck {
  id             String        @id @default(uuid())
  consentId      String
  consent        CreditConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)
  studentUserId  String
  /// Null for a self-pull; otherwise the organisation whose membership was used.
  organizationId String?
  /// SELF_PULL or LENDER_PULL — a hard enquiry only ever comes from the latter.
  kind           String
  /// SOFT or HARD, because a hard enquiry costs the subject something.
  enquiry        String
  /// The CIBIL score itself, 300-900. The co-applicant is shown their own; an
  /// organisation is only ever given the band, so an exact score stays between
  /// the bureau and the person it belongs to.
  score          Int?
  /// A band such as "750-799" — what discovery and the lender panel read.
  band           String?
  /// Why there is no band: NO_HISTORY, IDENTITY_MISMATCH, PROVIDER_ERROR.
  outcome        String
  /// The provider's own identifier, so a dispute can be traced without holding the report.
  providerRef    String?
  provider       String
  pulledAt       DateTime      @default(now())
  /// A band goes stale; past this the panel shows it as needing a refresh.
  staleAfter     DateTime

  @@index([studentUserId, pulledAt])
  @@index([organizationId])
  @@map("credit_checks")
}

/// Every attempt to reach a bureau, including the ones that failed.
///
/// Append-only and separate from `CreditCheck`, because a bureau contract asks
/// who tried, not only what succeeded.
model BureauPullAudit {
  id             String   @id @default(uuid())
  studentUserId  String?
  organizationId String?
  /// The officer or student who caused it.
  actorUserId    String?
  consentId      String?
  kind           String
  provider       String
  /// OK, DENIED_NO_CONSENT, DENIED_EXPIRED, PROVIDER_ERROR, IDENTITY_MISMATCH.
  result         String
  detail         String?
  at             DateTime @default(now())

  @@index([organizationId, at])
  @@index([studentUserId, at])
  @@map("bureau_pull_audits")
}

/// A partner bank's own bureau membership, used to pull under their entitlement
/// rather than the platform's.
///
/// The certificate and its password are never stored here — only a reference
/// into the secrets store, so a database dump cannot be used to impersonate a
/// bank at a credit bureau.
model OrganizationBureauCredential {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider        String
  /// The bank's member identifier with the bureau. Not secret on its own.
  memberId        String
  /// Where the certificate and key actually live: a secrets-manager key, never the material.
  secretRef       String
  /// So a rotation can be confirmed without reading the secret back.
  certFingerprint String?
  validFrom       DateTime?
  /// Certificates expire; the panel warns before a pull starts failing silently.
  validUntil      DateTime?
  status          String       @default("ACTIVE")
  rotatedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("organization_bureau_credentials")
}

/// What actually went out, per channel, per person.
///
/// The in-app thread almost never fails to accept a write, so until now there
/// was nothing worth recording. Email and WhatsApp fail all the time — a
/// number that has moved, a template Meta has not approved, a provider having
/// a bad morning — and "did the student get it?" has to be answerable without
/// reading logs.
model AutomationDelivery {
  id                String          @id @default(uuid())
  ruleId            String?
  rule              AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  offerId           String
  /// What the rule reacted to. With ruleId and actionIndex this is what keeps a
  /// retried request from sending the same WhatsApp message twice.
  triggerRef        String
  actionIndex       Int
  channel           String
  /// The user the message was addressed to, where one is known.
  recipientId       String?
  /// The address it was sent to, kept so a bounce can be traced to what we used.
  address           String?
  /// SENT, FAILED, SKIPPED or BLOCKED. A block is a rule of ours, not an error.
  status            String
  /// Why, in words, for anything that is not a plain send.
  reason            String?
  providerMessageId String?
  provider          String?
  attempts          Int             @default(0)
  createdAt         DateTime        @default(now())

  @@unique([offerId, ruleId, triggerRef, actionIndex, channel, recipientId])
  @@index([ruleId, createdAt])
  @@index([offerId])
  @@map("automation_deliveries")
}
